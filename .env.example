# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://outage:outage@localhost:5432/outage

# API bind address
BIND_ADDR=0.0.0.0:8080

# Fetch mode: "fixture" (default, deterministic, no network) or "live"
FETCH_MODE=fixture

# Directory holding HTML fixtures (relative to CWD or absolute)
FIXTURES_DIR=fixtures

# Logging
RUST_LOG=info
